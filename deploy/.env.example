# DROP IT local environment — пример переменных.
# КОПИРОВАТЬ в deploy/.env (или экспортировать в shell). .env НЕ коммитится.
# Реальных секретов здесь нет и не будет: значения — только local-заглушки.
#
# docker-compose.yml уже задаёт эти переменные для сервисов api/workers.
# Файл нужен для запуска бинарников на хосте (cargo run) и для справки.

# API / workers
DROPIT_BIND=0.0.0.0:8080
RUST_LOG=info,dropit=debug

# PostgreSQL (local-compose)
DATABASE_URL=postgres://dropit:dropit_local@localhost:5432/dropit

# Redis (local-compose) — WS-тикеты и pub/sub между узлами
REDIS_URL=redis://localhost:6379

# NATS (local-compose) — outbox-реле (ADR-002). Без переменной → NoopBus.
NATS_URL=nats://localhost:4222

# Миграции при старте: true — для локального стенда (применяет воркер);
# в prod — отдельным шагом, здесь false.
DROPIT_RUN_MIGRATIONS=false

# Stripe — по умолчанию пусто → MockStripe (реальные деньги НЕ проводятся).
# Live-ключи — только после закрытия ADR-004 (схема Connect) и Q11–Q15.
# STRIPE_API_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Push — по умолчанию пусто → NoopPush (уведомления никуда не уходят).
# FCM (Android):
# FCM_PROJECT_ID=dropit-prod
# FCM_SERVICE_ACCOUNT_JSON=<JSON сервисного аккаунта одной строкой>
# APNs (iOS):
# APNS_TEAM_ID=TEAM
# APNS_KEY_ID=KEY
# APNS_PRIVATE_KEY_P8=<содержимое .p8>
# APNS_TOPIC=app.bundle.id
# APNS_SANDBOX=1

# Mail — по умолчанию пусто → NoopMail (письма не уходят, журнал пишется).
# Транспорт — Resend HTTP API (ADR-008, docs/mail-infra-contract.md).
# Отправляет ВОРКЕР (dropit-workers, задача `mail`), не API.
# RESEND_API_KEY=re_...
# Секрет вебхука (svix-подпись). Без него POST /webhooks/resend отвечает 503.
# RESEND_WEBHOOK_SECRET=whsec_...
# Отправитель: обязателен, если задан ключ; иначе транспорт деградирует в Noop.
# MAIL_FROM=DROP IT <no-reply@dropit.club>
# MAIL_REPLY_TO=support@dropit.club
# База для ссылок в шаблонах (инвайт DJ, подтверждение e-mail).
# MAIL_APP_BASE_URL=http://localhost:5173
# Расписание диспетчера писем.
# MAIL_INTERVAL_SECS=2
# MAIL_BATCH_SIZE=50
# MAIL_MAX_ATTEMPTS=5
