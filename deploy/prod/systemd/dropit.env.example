# DROP IT — PROD runtime environment template (Test Mode stand).
#
# This is the TEMPLATE for the file the processes actually read:
#   /srv/dropit/etc/dropit.env      (chmod 600 dropit:dropit)
#
# It is rendered by deploy/prod/provision.sh, which substitutes the
# __PLACEHOLDER__ tokens from deploy/prod/.env.local (gitignored) and uploads
# the result. Real secrets NEVER live in this file or anywhere else in git.
#
# After provisioning, /srv/dropit/etc/dropit.env is the source of truth on the
# host. deploy.sh leaves it alone (so a redeploy cannot rotate secrets by
# accident); pass --sync-env to re-render and overwrite it deliberately.
#
# systemd EnvironmentFile format: KEY=value, one per line, no shell expansion,
# no quotes needed for alphanumeric values. Values with spaces must be quoted.

# ---------------------------------------------------------------------------
# Bind / logging
# ---------------------------------------------------------------------------
# Loopback only: nginx is the public listener on :80 and proxies to this port.
DROPIT_BIND=127.0.0.1:8080
RUST_LOG=info,dropit=info

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Role/db/host/port are fixed by provision.sh; the password is substituted
# here and also set on the role with ALTER ROLE, so the two cannot drift.
# Password alphabet is alphanumeric, which keeps the URL free of %-escapes.
DATABASE_URL=postgres://dropit:__DB_PASSWORD__@127.0.0.1:5432/dropit

# ---------------------------------------------------------------------------
# Redis — optional. WS tickets + pub/sub.
# ---------------------------------------------------------------------------
# Empty value => in-memory fallback (single node). provision.sh blanks this
# line automatically when redis-server is not installed/enabled.
REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------------------
# NATS — optional. Outbox relay (ADR-002).
# ---------------------------------------------------------------------------
# Empty => NoopBus: events accumulate in the outbox table and are not
# published. Nothing crashes; the relay task just skips.
NATS_URL=

# ---------------------------------------------------------------------------
# Migrations — MUST stay false on this host.
# ---------------------------------------------------------------------------
# crates/infra-db/src/migrations.rs bakes env!("CARGO_MANIFEST_DIR")/migrations
# at compile time, so on the server this flag panics instead of migrating.
# Migrations are applied by deploy.sh through psql (see host/migrate.sh).
DROPIT_RUN_MIGRATIONS=false

# ---------------------------------------------------------------------------
# Reverse proxy / client IP
# ---------------------------------------------------------------------------
# 1 = trust X-Forwarded-For / X-Real-IP (anti-fraud IP limits, admin master
# login). Correct here because the API is only reachable through nginx.
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Test Mode / open signup (docs/signup-contract.md)
# ---------------------------------------------------------------------------
# 1 = open registration on the stand: club/DJ accounts are created active,
# no e-mail verification, tokens returned immediately.
DROPIT_OPEN_SIGNUP=1
# Лимит успешных регистраций с одного IP в час (код по умолчанию — 10).
# На стенде поднят: демо-регистрация «в один клик» с общего IP/NAT иначе
# выжигает бюджет за минуты. Читается один раз при старте API.
DROPIT_SIGNUP_RATE_PER_HOUR=100

# ---------------------------------------------------------------------------
# Secrets — substituted from deploy/prod/.env.local
# ---------------------------------------------------------------------------
# JWT signing secret (random hex, 48 bytes).
DROPIT_JWT_SECRET=__JWT_SECRET__
# AES-256-GCM key for TOTP secrets: 32 bytes as 64 hex chars. Missing => the
# process errors out rather than silently storing TOTP in plaintext.
DROPIT_TOTP_KEY=__TOTP_KEY__

# ---------------------------------------------------------------------------
# Stripe — intentionally empty => MockStripe. No real money moves.
# Live keys wait on ADR-004 (Connect scheme) and owner decisions Q11–Q15.
# ---------------------------------------------------------------------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Push — intentionally empty => NoopPush. Notifications go nowhere.
# ---------------------------------------------------------------------------
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_P8=
APNS_TOPIC=
APNS_SANDBOX=
