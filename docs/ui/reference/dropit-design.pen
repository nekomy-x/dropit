                  "name": "Ограничения",
                  "fill": "#00FF87",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Не менять характер",
                  "lineHeight": 1.25,
                  "fontFamily": "Inter",
                  "fontSize": 26,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "LFK9D",
                  "name": "Ошибки",
                  "fill": "#F2F5F3",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Не растягивать, не переставлять наушники влево, не добавлять внешнее свечение и случайный glitch. Фирменный эффект меняет заливку внутри букв, сохраняя контур надписи.",
                  "lineHeight": 1.25,
                  "fontFamily": "Inter",
                  "fontSize": 23,
                  "fontWeight": "normal"
                },
