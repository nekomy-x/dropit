                  "type": "text",
                  "id": "dUTQp",
                  "name": "Размеры",
                  "fill": "#A5AEA9",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Охранное поле — не меньше высоты знака. Базовый размер — как в шапке приложения. При уменьшении проверить читаемость букв и ступеней; при потере деталей перейти к одноцветной версии.",
                  "lineHeight": 1.25,
                  "fontFamily": "Inter",
                  "fontSize": 21,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
