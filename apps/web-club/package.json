{
  "name": "@dropit/web-club",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc --noEmit && vite build --mode production",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "audit:ui": "node ../../scripts/ui-audit.mjs",
    "ui:check": "node ../../scripts/club-ui-check.mjs",
    "i18n:check": "node ../../scripts/i18n-check.mjs",
    "select:check": "node ../../scripts/select-audit.mjs --app club",
    "nav:check": "node ../../scripts/mobile-nav-check.mjs --app club"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
