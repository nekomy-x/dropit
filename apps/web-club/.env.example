# DROP IT — web-club public build variables.
#
# Copy to `.env.local` (or `.env.production.local` for a production build) only
# when a real listing exists; Vite reads env files when the build/dev server
# starts, so a change needs a restart.
#
# The guest app has no store listing yet, so BOTH variables stay unset and
# `/download` renders its honest "soon" state
# (see docs/ui/hub-download-contract.md §Store links). Only an absolute https
# URL is accepted; anything else is ignored rather than rendered as a broken
# link.
#
# Set a variable to turn the matching store button into a real external link
# (`target="_blank" rel="noreferrer"`, "Open App Store" / "Open Google Play").
#
# VITE_GUEST_IOS_URL=https://apps.apple.com/app/id0000000000
# VITE_GUEST_ANDROID_URL=https://play.google.com/store/apps/details?id=club.dropit.guest
# Optional applicationId override for a separately installed test APK.
# VITE_GUEST_ANDROID_PACKAGE=com.example.dropit_guest.test204

# Public Stripe key from the same Stripe account/mode as backend STRIPE_API_KEY.
# Without it, live card checkout is unavailable. If the backend uses MockStripe,
# /join offers the explicit test payment method without any Stripe key or card.
# VITE_GUEST_STRIPE_PUBLISHABLE_KEY=pk_test_...

# The test-stand APK is not configured here: the page probes
# /downloads/dropit-guest.apk with a HEAD request and shows the APK row only
# when that file was published (`node scripts/publish-guest-apk.mjs`).
